{
  "id": "root",
  "type": "row",
  "preview": "layouts/eden.svg",
  "titlebar": "none",
  "traffic_lights": [12, 13],
  "theme": "mono",
  "background": "canvas",
  "terminal_padding": [12, 10],
  "divider": { "width": 1, "color": "border" },
  "floating": [
    { "id": "nav", "content": { "mod": "nav" }, "edge": "bottom", "align": "end" }
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 210 },
      "min": 140,
      "max": 420,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "side-head",
          "type": "block",
          "size": { "px": 38 },
          "window_drag": true,
          "content": { "mod": "mono-side", "props": { "role": "head" } }
        },
        { "id": "side-list", "type": "block", "content": { "mod": "mono-side" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 38 },
          "window_drag": true,
          "content": { "mod": "mono-tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 6,
          "gap": 6,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 6,
                  "radius": 8,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "dim" },
                  "header": {
                    "content": { "mod": "mono-pane" },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 360 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status-row",
          "type": "row",
          "size": { "px": 26 },
          "resizable": false,
          "divider": { "width": 0, "color": "border" },
          "children": [
            { "id": "status", "type": "block", "content": { "mod": "mono-status" } },
            {
              "id": "live-ports",
              "type": "block",
              "size": { "px": 64 },
              "content": { "mod": "live-ports" }
            }
          ]
        }
      ]
    }
  ]
}
