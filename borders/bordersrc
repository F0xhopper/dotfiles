#!/bin/bash
# ~/.config/borders/bordersrc  (must be chmod +x)
# Docs: https://github.com/FelixKratz/JankyBorders/wiki/Man-Page
# Colors are 0xAARRGGBB.

options=(
  style=round
  width=1.0
  hidpi=on
  order=above

  active_color=0x66ffffff
  inactive_color=0x00ffffff
)

# Fancier options — pick one INSTEAD of active_color above:
# active_color="gradient(top_left=0xff7aa2f7,bottom_right=0xffbb9af7)"
# active_color="glow(0xff7aa2f7)"

# Only border these apps (comma separated, quoted). Leave commented for all apps.
# whitelist="Ghostty,WezTerm,kitty,Alacritty,Google Chrome,Firefox"

# Or exclude specific ones:
# blacklist="Finder,Spotify"

borders "${options[@]}"
